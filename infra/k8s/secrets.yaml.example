# Copy to secrets.yaml and fill in real values (secrets.yaml is gitignored).
#   cp secrets.yaml.example secrets.yaml && kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: trackfolio-secrets
  namespace: trackfolio
type: Opaque
stringData:
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "change-me"
  # Full URLs consumed by the app services (must match the values above).
  POSTGRES_URL: "postgres://postgres:change-me@postgres:5432/trackfolio?sslmode=disable"
  DATABASE_URL: "postgres://postgres:change-me@postgres:5432/trackfolio"
