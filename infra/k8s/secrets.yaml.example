# Copy to secrets.yaml and fill in real values. secrets.yaml is gitignored.
#   cp secrets.yaml.example secrets.yaml && kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: trackfolio-secrets
  namespace: trackfolio
type: Opaque
stringData:
  POSTGRES_PASSWORD: "changeme"
  # Full DSNs consumed by the app services (built from the password above).
  DATABASE_URL: "postgres://trackfolio:changeme@postgres:5432/trackfolio"
  POSTGRES_URL: "postgres://trackfolio:changeme@postgres:5432/trackfolio?sslmode=disable"
