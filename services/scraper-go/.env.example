SCRAPER_HTTP_ADDR=:8081
POSTGRES_URL=postgres://postgres:postgres@postgres:5432/trackfolio?sslmode=disable
MONGO_URI=mongodb://mongo:27017
MONGO_DB=trackfolio
REDIS_ADDR=redis:6379
# Comma-separated list of boards: greenhouse:<slug> or lever:<slug>
SCRAPER_SOURCES=greenhouse:stripe,greenhouse:airbnb,lever:netflix
# Override base URLs to point at a fixture server in tests/CI:
SCRAPER_GREENHOUSE_BASE=https://boards-api.greenhouse.io
SCRAPER_LEVER_BASE=https://api.lever.co
SCRAPER_WORKERS=10
SCRAPER_DEDUP_TTL=86400
